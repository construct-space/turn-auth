# Environment for turn-auth. Copy to .env and fill in real values; secrets say change-me.
TURN_SHARED_SECRET=change-me
TURN_REALM=turn.construct.space
TURN_TTL_SECONDS=86400
TURN_URLS=stun:turn.construct.space:3478,turn:turn.construct.space:3478?transport=udp,turn:turn.construct.space:3478?transport=tcp,turns:turn.construct.space:5349
INTERNAL_SHARED_SECRET=change-me
